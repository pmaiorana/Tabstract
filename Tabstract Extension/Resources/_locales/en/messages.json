  "guideAIFeaturesBody": {
    "message": "If your computer supports Apple Intelligence, Tabstract can automatically categorize your saved tabs into different topic-based groups. Click the <strong>✨ sparkle icon</strong> next to any group title to generate a new title. Computers that don't support Apple Intelligence will use the date and time instead."
  },
  "guideAIFeaturesTitle": {
    "message": "Tab Organization with AI"
  },
  "guideBadgeNotificationsBody": {
    "message": "The toolbar badge displays the number of saved groups, so they're not forgotten about even though they're out-of-sight. Snooze hides the toolbar badge for up to 24 hours, or you can disable it altogether in settings."
  },
  "guideBadgeNotificationsTitle": {
    "message": "Toolbar Badge"
  },
  "guideDragToReorderBody": {
    "message": "Click and drag individual links, and groups, to rearrange your saved tabs into any order you prefer."
  },
  "guideDragToReorderTitle": {
    "message": "Drag-and-Drop Organization"
  },
  "guideGettingStartedBody": {
    "message": "Tabstract helps you save and organize your Safari tabs. To get started, right-click the Safari toolbar, select Customize, and drag the Tabstract icon to your toolbar. Once installed in your toolbar, click Tabstract, then <strong>Save Tabs</strong> to capture all open tabs in the current window. "
  },
  "guideGettingStartedTitle": {
    "message": "Getting Started"
  },
  "guideKeyboardShortcutsBody": {
    "message": "Tabstract includes keyboard shortcuts and modifier key combinations for power users. Shortcuts can be disabled in Settings.<br><br><strong>Main shortcuts:</strong><br><br>Save all tabs: <kbd>Cmd</kbd> + <kbd>Shift</kbd> + <kbd>S</kbd><br>Save current tab only: <kbd>Cmd</kbd> + <kbd>Shift</kbd> + <kbd>D</kbd><br>Open saved groups list: <kbd>Cmd</kbd> + <kbd>Shift</kbd> + <kbd>H</kbd><br><br><strong>Quick actions:</strong><br><br>Focus search box: <kbd>/</kbd><br>Create new group: <kbd>N</kbd><br><br><strong>Modifier key combinations:</strong><br><br>Save only current tab: <kbd>Shift</kbd> + Click <em>Save Tabs</em><br>Expand/collapse all groups: <kbd>Shift</kbd> + Click <em>group collapse button</em><br>Temporarily reverse \"Remove tabs after restoring\" setting: <kbd>Shift</kbd> + Click <em>Restore</em><br>Temporarily reverse \"Restore tabs in background\" setting: <kbd>Option</kbd> + Click <em>Restore</em>"
  },
  "guideKeyboardShortcutsIntro": {
    "message": "Tabstract includes keyboard shortcuts and modifier key combinations for power users. Shortcuts can be disabled in Settings."
  },
  "guideKeyboardShortcutsList": {
    "message": "<strong>Main shortcuts:</strong><br><br>Save all tabs: <kbd>⌘ Cmd</kbd> + <kbd>⇧ Shift</kbd> + <kbd>S</kbd><br>Save current tab only: <kbd>⌘ Cmd</kbd> + <kbd>⇧ Shift</kbd> + <kbd>D</kbd><br>Open saved groups list: <kbd>⌘ Cmd</kbd> + <kbd>⇧ Shift</kbd> + <kbd>H</kbd><br><br><strong>Quick actions:</strong><br><br>Focus search box: <kbd>/</kbd><br>Create new group: <kbd>N</kbd><br><br><strong>Modifier key combinations:</strong><br><br>Save only current tab: <kbd>⇧ Shift</kbd> + Click <em>Save Tabs</em><br>Expand/collapse all groups: <kbd>⇧ Shift</kbd> + Click <em>group collapse button</em><br>Temporarily reverse \"Remove tabs after restoring\" setting: <kbd>⇧ Shift</kbd> + Click <em>Restore</em><br>Temporarily reverse \"Restore tabs in background\" setting: <kbd>⌥ Option</kbd> + Click <em>Restore</em>"
  },
  "guideKeyboardShortcutsTitle": {
    "message": "Keyboard Shortcuts"
  },
  "guideKeyboardShortcutsToggle": {
    "message": "View all shortcuts"
  },
  "guidePasteLinksBody": {
    "message": "You can copy links from other applications and paste those URLs directly into Tabstract! Tabstract will automatically fetch the page titles and add them to your collection. "
  },
  "guidePasteLinksTitle": {
    "message": "Copy-and-Paste Links into Tabstract"
  },
  "guideShiftClickBody": {
    "message": "Hold <kbd>Shift</kbd> while clicking any group's collapse button to expand or collapse all groups at once."
  },
  "guideShiftClickTitle": {
    "message": "Shift-Click to Expand/Collapse All"
  },
  "guideTrashUndoBody": {
    "message": "Deleted links are moved to trash for 30 days before they are then automatically deleted. Trash is limited to 1,000 items to help keep Tabstract fast."
  },
  "guideTrashUndoTitle": {
    "message": "Trash"
  },
  "helpPageTitle": {
    "message": "Support and Troubleshooting - Tabstract"
  },
  "helpSupportInstructions": {
    "message": "Have questions, feature requests, or need help? Click <em>Email Support</em> then <em>Allow</em>, or email your System Report to <em>help@tabstract.app</em>, along with any details about your issue.<br /><br />Please also feel free to email us with feature requests, bug reports, translation improvements, etc."
  },
